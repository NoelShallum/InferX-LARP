{
  "name": "inferx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inference economics planner for a small GPU fleet: which GPUs, which models, rent or own.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:vast": "node scripts/vast.mjs",
    "data:openrouter": "node scripts/openrouter.mjs",
    "data": "npm run data:vast && npm run data:openrouter && npm run data:inferencex",
    "data:hf": "node scripts/hf.mjs",
    "data:inferencex": "node scripts/inferencex.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
